# Copy to .env and replace placeholders with your own Snowflake settings.
# For Google/browser authentication supported by your Snowflake account:
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_USER=your_username
SNOWFLAKE_AUTHENTICATOR=OAUTH_AUTHORIZATION_CODE
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_DATABASE=RETAIL_PORTFOLIO
SNOWFLAKE_SCHEMA=RAW

# Only if your account uses Snowflake password authentication instead:
# SNOWFLAKE_AUTHENTICATOR=snowflake
# SNOWFLAKE_PASSWORD=your_password
